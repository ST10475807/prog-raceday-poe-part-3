@model List<RaceDay.Mvc.Models.EnrolmentVm>
@{var ev=(RaceDay.Mvc.Models.EventVm?)ViewBag.Event;}
<h1 class="page-title">Race results · @ev?.EventName</h1><p class="text-muted">Enter each participant's finishing position and finish time, then save the result.</p>
<div class="d-grid gap-3">@foreach(var e in Model){<form asp-action="SaveResult" method="post" class="card-surface row g-2 align-items-end"><input type="hidden" name="id" value="@e.EventId"/><input type="hidden" name="enrolmentId" value="@e.EnrolmentId"/><div class="col-md-3"><strong>@e.Participant</strong><div class="small text-muted">@e.CategoryName</div></div><div class="col-md-2"><label class="form-label">Position</label><input name="finishPosition" type="number" min="1" value="@e.FinishPosition" class="form-control"/></div><div class="col-md-3"><label class="form-label">Finish time</label><input name="finishTime" type="time" step="1" value="@(e.FinishTime?.ToString("hh\:mm\:ss"))" class="form-control"/></div><div class="col-md-2"><label class="form-label">Status</label><select name="resultStatus" class="form-select"><option selected="@(e.ResultStatus=="Finished")">Finished</option><option selected="@(e.ResultStatus=="DNF")">DNF</option><option selected="@(e.ResultStatus=="DNS")">DNS</option><option selected="@(e.ResultStatus=="Pending")">Pending</option></select></div><div class="col-md-2"><button class="btn btn-warning w-100">Save result</button></div></form>}@if(Model.Count==0){<div class="card-surface">There are no enrolments for this event.</div>}</div>

@model RaceDay.Mvc.Models.CategoryVm
@{var ev=(RaceDay.Mvc.Models.EventVm?)ViewBag.Event;var assigned=(List<RaceDay.Mvc.Models.CategoryVm>)ViewBag.Assigned;var available=(List<RaceDay.Mvc.Models.CategoryVm>)ViewBag.Categories;int eventId=(int)ViewBag.EventId;}
<h1 class="page-title">Categories · @ev?.EventName</h1><div class="row g-4"><div class="col-lg-7"><div class="card-surface"><h4>Assigned categories</h4><div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Age</th><th>Distance</th><th>Capacity</th><th></th></tr></thead><tbody>@foreach(var c in assigned){<tr><td>@c.CategoryName</td><td>@c.MinAge–@c.MaxAge</td><td>@(c.DistanceKm?.ToString()??"—") km</td><td>@c.MaxParticipants</td><td><form asp-action="RemoveCategory" method="post"><input type="hidden" name="eventId" value="@eventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>}</tbody></table></div></div><div class="card-surface mt-3"><h4>Assign existing category</h4>@foreach(var c in available.Where(x=>assigned.All(a=>a.CategoryId!=x.CategoryId))){<form asp-action="AssignCategory" method="post" class="row g-2 align-items-end border-bottom py-2"><input type="hidden" name="eventId" value="@eventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><div class="col"><strong>@c.CategoryName</strong></div><div class="col"><input name="maxParticipants" type="number" min="1" value="100" class="form-control" placeholder="Capacity"/></div><div class="col"><input name="entryFee" type="number" min="0" step="0.01" value="0" class="form-control" placeholder="Fee"/></div><div class="col-auto"><button class="btn btn-sm btn-dark">Assign</button></div></form>}</div></div><div class="col-lg-5"><form asp-action="CreateCategory" method="post" class="card-surface"><h4>Create category</h4><input type="hidden" name="eventId" value="@eventId"/><div class="mb-2"><label class="form-label">Category name</label><input asp-for="CategoryName" class="form-control" required/></div><div class="mb-2"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control"></textarea></div><div class="row"><div class="col"><label class="form-label">Minimum age</label><input asp-for="MinAge" class="form-control" type="number" min="0"/></div><div class="col"><label class="form-label">Maximum age</label><input asp-for="MaxAge" class="form-control" type="number" min="0"/></div></div><div class="mt-2"><label class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01"/></div><div class="mt-2"><label class="form-label">Category capacity</label><input asp-for="MaxParticipants" class="form-control" type="number" min="1"/></div><div class="mt-2"><label class="form-label">Entry fee</label><input asp-for="EntryFee" class="form-control" type="number" min="0" step="0.01"/></div><button class="btn btn-warning mt-3">Create and assign</button></form></div></div>

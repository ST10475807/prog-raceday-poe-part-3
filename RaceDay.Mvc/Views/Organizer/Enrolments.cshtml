@model List<RaceDay.Mvc.Models.EnrolmentVm>
@{var ev=(RaceDay.Mvc.Models.EventVm?)ViewBag.Event;}
<h1 class="page-title">Enrolments · @ev?.EventName</h1><div class="card-surface table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Enrolled</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Participant</td><td>@e.Email</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status status-@e.Status.ToLowerInvariant()">@e.Status</span></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted">No participants have enrolled yet.</p>}</div>

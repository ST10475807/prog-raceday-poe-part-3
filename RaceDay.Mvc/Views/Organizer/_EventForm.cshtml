@model RaceDay.Mvc.Models.EventVm
<form method="post" enctype="multipart/form-data" class="card-surface form-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="EventName" class="form-label">Event name</label><input asp-for="EventName" class="form-control"/><span asp-validation-for="EventName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="StartTime" class="form-label">Start time</label><input asp-for="StartTime" type="time" class="form-control"/></div><div class="col-md-4"><label asp-for="MaxParticipants" class="form-label">Maximum participants</label><input asp-for="MaxParticipants" type="number" min="1" class="form-control"/></div><div class="col-md-6"><label asp-for="Venue" class="form-label"></label><input asp-for="Venue" class="form-control"/></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Draft</option><option>Open</option><option>Closed</option><option>Completed</option><option>Cancelled</option></select></div><div class="col-md-6"><label class="form-label">Event banner image</label><input type="file" name="banner" class="form-control" accept="image/*"/><div class="form-text">Images are uploaded through the API to configured Blob Storage.</div></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-warning">Save event</button><a asp-action="Dashboard" class="btn btn-light">Cancel</a></div></form>

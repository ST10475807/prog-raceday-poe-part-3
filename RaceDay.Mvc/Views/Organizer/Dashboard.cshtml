@model List<RaceDay.Mvc.Models.EventVm>
@{ var counts=(Dictionary<int,int>)ViewBag.Counts; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><span class="eyebrow">ORGANISER HUB</span><h1 class="page-title">Your race events</h1><p class="text-muted mb-0">Manage events, categories, participants and results.</p></div><a class="btn btn-warning" asp-action="Create">＋ Create event</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>Total events</span><strong>@Model.Count</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Total active enrolments</span><strong>@counts.Values.Sum()</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>@Model.Count(x=>x.EventDate.Date>=DateTime.Today)</strong></div></div></div>
<div class="table-responsive card-surface"><table class="table align-middle mb-0"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><strong>@e.EventName</strong><div class="small text-muted">@e.EventType · @e.Location</div></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@(counts.GetValueOrDefault(e.EventId)) / @e.MaxParticipants</td><td><span class="status status-@e.Status.ToLowerInvariant()">@e.Status</span></td><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@e.EventId">Edit</a><a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a><a class="btn btn-sm btn-outline-dark" asp-action="Results" asp-route-id="@e.EventId">Results</a><form asp-action="Delete" method="post" onsubmit="return confirm('Delete this event?')"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>}</tbody></table></div>

@model List<RaceDay.Mvc.Models.EventVm>
<section class="hero p-5 mb-4"><span class="eyebrow text-warning">YOUR NEXT FINISH LINE STARTS HERE</span><h1>Find your next race.</h1><p>Run. Walk. Cycle. Challenge yourself with the RaceDay community.</p></section><div class="d-flex flex-wrap justify-content-between align-items-end mb-3"><div><h2 class="section-title mb-1">Upcoming events</h2><p class="text-muted mb-0">Discover events and secure your place.</p></div></div><form method="get" class="card-surface mb-4"><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Event type</label><select name="eventType" class="form-select"><option value="">All types</option><option selected="@((ViewBag.EventType as string) == "Run")">Run</option><option selected="@((ViewBag.EventType as string) == "Walk")">Walk</option><option selected="@((ViewBag.EventType as string) == "Cycle")">Cycle</option></select></div><div class="col-md-3"><label class="form-label">From date</label><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control"/></div><div class="col-md-3"><label class="form-label">To date</label><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control"/></div><div class="col-md-2 d-flex gap-2"><button class="btn btn-warning flex-grow-1">Filter</button><a asp-action="Index" class="btn btn-light">Clear</a></div></div></form><div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><article class="event-card h-100">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img src="@e.BannerImageUrl" alt="@e.EventName" class="event-thumb"/>}else{<div class="event-thumb thumb-placeholder">🏁</div>}<div class="p-3"><span class="status status-open">@e.EventType</span><h3 class="mt-2">@e.EventName</h3><p class="text-muted">@e.Description</p><div class="small fw-semibold">@e.EventDate.ToString("dd MMM yyyy") · @e.Location</div><a class="btn btn-dark mt-3" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">Explore event</a></div></article></div>}@if(Model.Count==0){<div class="col-12"><div class="card-surface">No upcoming events match your filters. Try another date or event type.</div></div>}</div>

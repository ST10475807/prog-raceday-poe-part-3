@model RaceDay.Mvc.Models.EventDetailsVm
<div class="event-cover">@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" alt="@Model.EventName banner"/>}else{<div class="cover-placeholder"><span>RACEDAY</span><h1>@Model.EventName</h1></div>}</div><span class="eyebrow">@Model.EventType EVENT</span><h1 class="page-title">@Model.EventName</h1><p class="lead">@Model.Description</p><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>Date & time</span><strong class="fs-5">@Model.EventDate.ToString("dd MMM yyyy")</strong><small>@Model.StartTime.ToString("hh\:mm")</small></div></div><div class="col-md-4"><div class="stat-card"><span>Venue</span><strong class="fs-5">@Model.Venue</strong><small>@Model.Location</small></div></div><div class="col-md-4"><div class="stat-card"><span>Capacity</span><strong class="fs-5">@Model.MaxParticipants</strong><small>Maximum participants</small></div></div></div><h3 class="section-title">Available categories</h3><div class="row g-3">@foreach(var c in Model.Categories){<div class="col-md-6"><div class="card-surface h-100"><h4>@c.CategoryName</h4><p class="text-muted">@c.Description</p><p>Age: @c.MinAge–@c.MaxAge · Distance: @(c.DistanceKm?.ToString()??"Varies") km</p><p>Entry fee: R @c.EntryFee.ToString("0.00")</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="eventId" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-warning">Enrol now</button></form>}else if(Context.Session.GetString("Token")==null){<a asp-controller="Account" asp-action="Login" class="btn btn-dark">Log in to enrol</a>}</div></div>}@if(Model.Categories.Count==0){<p class="text-muted">Categories have not been published for this event yet.</p>}</div>

@model RaceDay.Mvc.Models.ProfileVm
<h1 class="page-title">My profile</h1><div class="row g-4"><div class="col-md-4"><div class="card-surface text-center"><div class="avatar-wrap">@if(!string.IsNullOrWhiteSpace(Model.ProfileImageUrl)){<img src="@Model.ProfileImageUrl" alt="Profile picture" class="profile-avatar"/>}else{<div class="profile-avatar avatar-placeholder">@(Model.FirstName.FirstOrDefault())</div>}</div><h4>@Model.FirstName @Model.LastName</h4><p class="text-muted">@Model.Role</p><form asp-action="UploadPicture" method="post" enctype="multipart/form-data"><input type="file" name="picture" accept="image/*" class="form-control mb-2" required/><button class="btn btn-dark w-100">Upload profile picture</button></form></div></div><div class="col-md-8"><form asp-action="Profile" method="post" class="card-surface"><div class="mb-3"><label class="form-label">First name</label><input asp-for="FirstName" class="form-control"/></div><div class="mb-3"><label class="form-label">Last name</label><input asp-for="LastName" class="form-control"/></div><div class="mb-3"><label class="form-label">Email address</label><input asp-for="Email" class="form-control" readonly/></div><div class="mb-3"><label class="form-label">Phone number</label><input asp-for="Phone" class="form-control"/></div><button class="btn btn-warning">Save profile</button></form></div></div>

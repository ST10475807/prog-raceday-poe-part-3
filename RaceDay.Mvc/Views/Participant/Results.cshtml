@model List<RaceDay.Mvc.Models.ResultVm>
<h1 class="page-title">My race results</h1><p class="text-muted">Your personal race history from completed events.</p><div class="card-surface table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@r.EventName</strong></td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString("hh\:mm\:ss")??"—")</td><td>@r.PositionLabel</td><td><span class="status status-@r.ResultStatus.ToLowerInvariant()">@r.ResultStatus</span></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted">No published results are available yet. Results appear here after the organiser records them.</p>}</div>

@model List<RaceDay.Mvc.Models.EnrolmentVm>
<h1 class="page-title">My events</h1><p class="text-muted">Your event registrations and current status.</p><div class="card-surface table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Category</th><th>Enrolment date</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><strong>@e.EventName</strong></td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status status-@e.Status.ToLowerInvariant()">@e.Status</span></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted">You have not enrolled in any events yet. Browse upcoming races to get started.</p>}</div>

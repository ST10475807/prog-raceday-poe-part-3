<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark raceday-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a>@if(Context.Session.GetString("Role")=="Organizer"){<a class="nav-link" asp-controller="Organizer" asp-action="Dashboard">Organiser dashboard</a>}@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>}@if(Context.Session.GetString("Token")!=null){<span class="nav-link text-warning">Hi, @Context.Session.GetString("Name")</span><form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="btn btn-sm btn-outline-light ms-lg-2">Log out</button></form>}else{<a class="nav-link" asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-warning btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav><main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-info alert-dismissible fade show" role="alert">@TempData["Message"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}@RenderBody()</main><footer class="container py-4 mt-4 border-top text-muted small">© @DateTime.Now.Year RaceDay · Every finish line is a new beginning.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
